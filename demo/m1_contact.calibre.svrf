// =============================================================================
// M1 / Contact DRC demo — Calibre SVRF rules (mirrors demo/m1_contact.drc)
// =============================================================================
// Layers (from generate_layout.rb):
//   M1  GDS 31/0
//   CT  GDS 30/0
//
// This file contains RULES ONLY — no LAYOUT PATH / RDB paths.
// Paths come from:
//   • calibredrv Tcl:  run_drc_in_calibredrv.tcl  (uses open layout)
//   • batch shell:     run_calibre_drc.sh          (writes a temp run deck)
//   • Calibre Interactive: select layout + this rule file in the GUI
// =============================================================================

PRECISION 1000
RESOLUTION 1

LAYER M1 31 0
LAYER CT 30 0

DRC MAXIMUM RESULTS ALL
DRC KEEP EMPTY NO

// ---------------------------------------------------------------------------
// Metal 1
// ---------------------------------------------------------------------------

M1_MIN_WIDTH {
  @ Metal1 width < 0.14 um
  INT M1 < 0.14 ABUT < 90 SINGULAR
}

M1_MIN_SPACE {
  @ Metal1 spacing < 0.14 um
  EXT M1 < 0.14 ABUT < 90 SINGULAR
}

// ---------------------------------------------------------------------------
// Contact
// ---------------------------------------------------------------------------

CT_MIN_WIDTH {
  @ Contact width < 0.16 um
  INT CT < 0.16 ABUT < 90 SINGULAR
}

CT_MIN_SPACE {
  @ Contact spacing < 0.18 um
  EXT CT < 0.18 ABUT < 90 SINGULAR
}

// ---------------------------------------------------------------------------
// Enclosure — M1 must surround CT by at least 0.055 um
// SIZE CT outward; any oversized contact not fully inside M1 is a violation.
// (More robust on Calibre 2019 than ENC ... OPPOSITE for this demo.)
// ---------------------------------------------------------------------------

CT_GROWN = SIZE CT BY 0.055

M1_OVER_CT_ENCLOSURE {
  @ M1 enclosure of contact < 0.055 um
  CT_GROWN NOT INSIDE M1
}
