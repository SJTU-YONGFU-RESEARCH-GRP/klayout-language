# Copy to calibre.env and edit paths for your site:
#   cp calibre.env.example calibre.env
#
# run_calibre_drc.sh sources calibre.env automatically when present.
#
# This machine's known values (already written to calibre.env):
#   MGC_HOME=/data1/eda/eda/mentor/aoi_cal_2019.2_26.18
#   MGLS_LICENSE_FILE=/data1/eda/eda/mentor/mentor2019.dat

# Mentor/Siemens Calibre install root (contains bin/calibre)
export MGC_HOME=/data1/eda/eda/mentor/aoi_cal_2019.2_26.18
export CALIBRE_HOME="$MGC_HOME"
export CALIBRE="$MGC_HOME/bin/calibre"
export CALDRV="$MGC_HOME/bin/calibredrv"

# License file or server (this site uses a local .dat file)
export MGLS_LICENSE_FILE=/data1/eda/eda/mentor/mentor2019.dat
# Alternate form for a license server:
# export MGLS_LICENSE_FILE=1717@license-server.example.com

export PATH="$MGC_HOME/bin:$PATH"

# Optional: RHEL 9 GStreamer stubs for older Calibre GUI binaries
STUBDIR="${HOME}/local/lib/calibre-stubs"
if [[ -d "$STUBDIR" ]]; then
  export LD_LIBRARY_PATH="${STUBDIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
