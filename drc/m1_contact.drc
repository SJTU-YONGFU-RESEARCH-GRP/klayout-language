# KLayout DRC — Metal 1 and Contact demo
#
# Layers (see generate_layout.rb):
#   M1  31/0
#   CT  30/0
#
# Run: ./run_demo.sh

M1_MIN_WIDTH   = 0.14
M1_MIN_SPACE   = 0.14
M1_OVER_CT_ENC = 0.055
CT_MIN_WIDTH   = 0.16
CT_MIN_SPACE   = 0.18

if $input
  source($input)
end

report("M1 / Contact DRC demo", $report || "m1_contact.lyrdb", "M1_CT_DRC_DEMO")
if $input
  def_output.rdb.original_file = $input
end

metal1  = input(31, 0)
contact = input(30, 0)

metal1.width(M1_MIN_WIDTH.um).output(
  "M1.min_width",
  "Metal1 width < #{M1_MIN_WIDTH} µm"
)

metal1.space(M1_MIN_SPACE.um).output(
  "M1.min_space",
  "Metal1 spacing < #{M1_MIN_SPACE} µm"
)

contact.width(CT_MIN_WIDTH.um).output(
  "CT.min_width",
  "Contact width < #{CT_MIN_WIDTH} µm"
)

contact.space(CT_MIN_SPACE.um).output(
  "CT.min_space",
  "Contact spacing < #{CT_MIN_SPACE} µm"
)

metal1.enclosing(contact, M1_OVER_CT_ENC.um).output(
  "M1.over_CT.enclosure",
  "M1 enclosure of contact < #{M1_OVER_CT_ENC} µm"
)
