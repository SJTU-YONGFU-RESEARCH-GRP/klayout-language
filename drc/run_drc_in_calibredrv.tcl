# =============================================================================
# Run M1/Contact DRC from inside Calibre DESIGNrev (calibredrv)
# =============================================================================
# Pulls GDS path + top cell from the open layout — no GDS/RDB/REP env vars.
#
# From an open DESIGNrev GUI console:
#   source /path/to/drc/run_drc_in_calibredrv.tcl
#   run_m1_contact_drc
#
# Or via wrapper:
#   ./view_calibre_drc.sh
#
# Batch (wrapper sets DRV_AUTORUN=1):
#   calibredrv -shell -s run_drc_in_calibredrv.tcl -- -gds file.gds -rdb out.rdb
# =============================================================================

proc _demo_dir {} {
  set script [info script]
  if {$script eq ""} {
    return [pwd]
  }
  return [file dirname [file normalize $script]]
}

proc _pick_layout {preferred} {
  set handles [layout all]
  if {[llength $handles] > 0} {
    set L [lindex $handles 0]
    puts "==> Using open layout: $L  file=[$L file]  top=[$L topcell]"
    return $L
  }
  if {$preferred ne "" && [file exists $preferred]} {
    puts "==> Opening layout: $preferred"
    return [layout create $preferred]
  }
  set fallback [file join [_demo_dir] m1_contact_demo.gds]
  if {[file exists $fallback]} {
    puts "==> Opening demo layout: $fallback"
    return [layout create $fallback]
  }
  error "No layout open and no GDS found. Open a layout in calibredrv first."
}

proc _write_run_deck {gds primary rules rdb rep run_svrf} {
  set fh [open $run_svrf w]
  puts $fh "// Auto-generated by run_drc_in_calibredrv.tcl — do not edit"
  puts $fh "LAYOUT PATH \"$gds\""
  puts $fh "LAYOUT PRIMARY \"$primary\""
  puts $fh "LAYOUT SYSTEM GDSII"
  puts $fh "DRC SUMMARY REPORT \"$rep\""
  puts $fh "DRC RESULTS DATABASE \"$rdb\" ASCII"
  puts $fh "INCLUDE \"$rules\""
  close $fh
}

proc run_m1_contact_drc {{gds_arg ""} {rdb_arg ""}} {
  set demo [_demo_dir]
  set rdb $rdb_arg
  if {$rdb eq ""} {
    set rdb [file join $demo m1_contact.calibre.rdb]
  }

  set rules [file join $demo m1_contact.calibre.svrf]
  set rep [file rootname $rdb].rep
  set log [file rootname $rdb].log
  set work [file join $demo .calibre_run]
  file mkdir $work
  set run_svrf [file join $work run_from_drv.svrf]

  set L [_pick_layout $gds_arg]
  set gds [$L file]
  set primary [$L topcell]

  if {![file exists $rules]} {
    error "Rule file not found: $rules"
  }

  _write_run_deck $gds $primary $rules $rdb $rep $run_svrf
  puts "==> Rules:  $rules"
  puts "==> GDS:    $gds  (from calibredrv)"
  puts "==> Cell:   $primary"
  puts "==> RDB:    $rdb"

  set calibre_bin calibre
  if {[info exists ::env(CALIBRE)] && $::env(CALIBRE) ne ""} {
    set calibre_bin $::env(CALIBRE)
  } elseif {[info exists ::env(MGC_HOME)] && $::env(MGC_HOME) ne ""} {
    set calibre_bin [file join $::env(MGC_HOME) bin calibre]
  }

  puts "==> Exec:   $calibre_bin -drc -hier -turbo -nowait $run_svrf"
  if {[catch {exec $calibre_bin -drc -hier -turbo -nowait $run_svrf > $log 2>@1} result]} {
    puts "ERROR: calibre failed:\n$result"
    puts "See log: $log"
    return -code error $result
  }

  puts "==> DRC finished."
  if {[file exists $rep]} {
    set rf [open $rep r]
    set text [read $rf]
    close $rf
    foreach line [split $text \n] {
      if {[string match "*RULECHECK*" $line] || [string match "*TOTAL DRC*" $line]} {
        puts "    $line"
      }
    }
  }
  puts "==> Results: $rdb"
  puts "==> Done. View with: calibredrv \"$gds\" -rve -drc \"$rdb\""
  return $rdb
}

# Parse calibredrv script args: -- -gds <file> -rdb <file>
# (calibredrv requires the first -- argument to begin with '-')
proc _parse_drv_argv {argv} {
  set gds ""
  set rdb ""
  for {set i 0} {$i < [llength $argv]} {incr i} {
    set a [lindex $argv $i]
    switch -exact -- $a {
      -gds - -layout {
        incr i
        set gds [lindex $argv $i]
      }
      -rdb - -results {
        incr i
        set rdb [lindex $argv $i]
      }
      -h - -help {
        puts "Usage: calibredrv -shell -s run_drc_in_calibredrv.tcl -- -gds file.gds -rdb out.rdb"
      }
    }
  }
  if {$gds eq "" && [info exists ::env(DRV_GDS)]} { set gds $::env(DRV_GDS) }
  if {$rdb eq "" && [info exists ::env(DRV_RDB)]} { set rdb $::env(DRV_RDB) }
  return [list $gds $rdb]
}

# Auto-run only when launched by view_calibre_drc.sh (DRV_AUTORUN=1).
# Interactive `source` in DESIGNrev only defines procs — type: run_m1_contact_drc
if {[info exists ::env(DRV_AUTORUN)] && $::env(DRV_AUTORUN) eq "1"} {
  set _argv {}
  if {[info exists argv]} { set _argv $argv }
  lassign [_parse_drv_argv $_argv] _gds _rdb
  if {[catch {run_m1_contact_drc $_gds $_rdb} _err]} {
    puts stderr "DRC failed: $_err"
    exit 1
  }
  exit 0
}

puts "==> Loaded run_drc_in_calibredrv.tcl"
puts "    Open a layout, then type:  run_m1_contact_drc"
