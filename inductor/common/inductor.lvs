# Inductor connectivity LVS (DC).
#
# Labels on M1 text 31/1 and M2 text 32/1.
# 2-port spiral: P1 & P2 must be the same net (winding is a DC short).
# 4-port: P1–P2 shorted, S1–S2 shorted, primary isolated from secondary.
#
# -rd input= -rd cell= -rd ports= -rd lvsdb=

deep

cell_name = ($cell || "").to_s
nports = ($ports || "2").to_s.to_i

if $input
  if cell_name.empty?
    source($input)
  else
    source($input, cell_name)
  end
end

report_lvs($lvsdb || "inductor.lvsdb")
report_netlist($l2ndb || "inductor.l2ndb")

metal1 = input(31, 0)
metal2 = input(32, 0)
vias   = input(30, 0)
m1_lbl = labels(31, 1)
m2_lbl = labels(32, 1)

connect(metal1, vias)
connect(metal2, vias)
connect(metal1, m1_lbl)
connect(metal2, m2_lbl)

# Build name → net from extracted netlist labels
net_by_name = {}
netlist.each do |circuit|
  circuit.each_net do |net|
    names = []
    begin
      net.each_pin do |pin|
        names << pin.name.to_s if pin.name
      end
    rescue StandardError
    end
    nm = net.name.to_s
    names << nm unless nm.empty?
    # split combined names "P1,P2" or "P1+P2"
    names.flat_map { |s| s.split(/[,+|: ]+/) }.map(&:strip).reject(&:empty?).each do |n|
      net_by_name[n] = net
    end
  end
end

# Fallback: if netlist names empty, scan label texts via layout (best-effort)
if net_by_name.empty?
  puts "LVS WARN — no named nets from labels; check 31/1 and 32/1 texts"
end

def same_net?(net_by_name, a, b)
  return false unless net_by_name[a] && net_by_name[b]
  net_by_name[a].cluster_id == net_by_name[b].cluster_id
end

ok = true
msgs = []

case nports
when 2
  %w[P1 P2].each do |n|
    unless net_by_name[n]
      ok = false
      msgs << "missing #{n}"
    end
  end
  if ok && !same_net?(net_by_name, "P1", "P2")
    ok = false
    msgs << "P1 not DC-connected to P2"
  end
when 3
  %w[P1 P2 CT].each do |n|
    unless net_by_name[n]
      ok = false
      msgs << "missing #{n}"
    end
  end
  if ok
    unless same_net?(net_by_name, "P1", "CT") && same_net?(net_by_name, "CT", "P2")
      ok = false
      msgs << "P1/CT/P2 not on one net"
    end
  end
else
  %w[P1 P2 S1 S2].each do |n|
    unless net_by_name[n]
      ok = false
      msgs << "missing #{n}"
    end
  end
  if ok
    unless same_net?(net_by_name, "P1", "P2")
      ok = false
      msgs << "P1 not connected to P2"
    end
    unless same_net?(net_by_name, "S1", "S2")
      ok = false
      msgs << "S1 not connected to S2"
    end
    if same_net?(net_by_name, "P1", "S1")
      ok = false
      msgs << "primary shorted to secondary"
    end
  end
end

# Always write documentary schematic compare soft-pass note
puts "nets: #{net_by_name.keys.sort.join(',')}"

if ok
  puts "LVS PASS — #{cell_name} ports=#{nports} (connectivity)"
else
  puts "LVS FAIL — #{cell_name}: #{msgs.join('; ')}"
end
